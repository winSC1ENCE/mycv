{
  "name": "mycv-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,vue}\" \"tests/**/*.{ts,vue}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css,html,json}\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@unhead/vue": "^1.11.20",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.7.9",
    "gsap": "^3.12.5",
    "pinia": "^2.3.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.13",
    "vue-advanced-cropper": "^2.8.9",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
