# Copy to .env and fill in real values.
# Never commit .env — it is in .gitignore.

# --- Django ---
SECRET_KEY=change-me-in-prod
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=cv.chlous.top,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://cv.chlous.top
CSRF_TRUSTED_ORIGINS=https://cv.chlous.top
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgres://mycv:mycv@db:5432/mycv
POSTGRES_DB=mycv
POSTGRES_USER=mycv
POSTGRES_PASSWORD=change-me-in-prod

# --- Sentry (optional — leave blank to disable) ---
SENTRY_DSN=
SENTRY_ENV=prod
SENTRY_TRACES_RATE=0.1

# --- Frontend ---
VITE_API_BASE=/api
VITE_SENTRY_DSN=
