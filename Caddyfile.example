# Merge this snippet into the existing Caddyfile on your host.
# Replace your-domain.tld with your actual hostname before reloading Caddy.
# See docs/deployment.md for step-by-step instructions.

your-domain.tld {
    encode gzip zstd

    header {
        # Security headers — Caddy layer (complement Django's CSP)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options   "nosniff"
        X-Frame-Options          "DENY"
        Referrer-Policy          "strict-origin-when-cross-origin"
        Permissions-Policy       "geolocation=(), microphone=(), camera=()"
        -Server
    }

    # Backend handles API, Django admin, static/media files, sitemaps, robots
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /django-admin/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /static/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /media/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /sitemap.xml {
        reverse_proxy 127.0.0.1:8000
    }
    handle /robots.txt {
        reverse_proxy 127.0.0.1:8000
    }

    # Everything else → Vue frontend
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
